{
  "name": "unknown0-browser",
  "version": "0.1.15",
  "private": true,
  "description": "unknown0 — a privacy browser for token holders (prototype)",
  "author": "unknown0",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:swap": "esbuild src/swap/swap-app.js --bundle --format=iife --outfile=src/ui/swap.bundle.js --minify",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.24.0",
    "viem": "^2.21.0",
    "@walletconnect/ethereum-provider": "^2.17.0"
  },
  "build": {
    "appId": "io.unknown0.browser",
    "productName": "unknown0",
    "artifactName": "${productName}-${version}-${os}.${ext}",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "target": ["dmg"]
    },
    "win": {
      "icon": "build/icon.png",
      "target": ["nsis"]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": ["AppImage"],
      "category": "Network"
    }
  }
}
