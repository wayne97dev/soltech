# ----- Server -----
PORT=4000
NODE_ENV=development
# Origini web ammesse (CORS), separate da virgola
CORS_ORIGIN=http://localhost:3000

# ----- Auth -----
# In produzione: stringa lunga e casuale!
JWT_SECRET=dev-insecure-secret-change-me
# Durata della sessione di login
JWT_TTL=7d

# ----- Database -----
# Dev: SQLite (zero setup). Prod: cambia provider in schema.prisma e usa Postgres.
DATABASE_URL="file:./dev.db"

# ----- Solana / token gating -----
# Endpoint RPC. Quelli pubblici sono rate-limited: in prod usa Helius/QuickNode.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Mint address del token SPL (lo avrai da pump.fun dopo il lancio). Vuoto = non ancora lanciato.
TOKEN_MINT=
# Quanti token (interi, non raw) servono per la VPN gratis.
MIN_TOKEN_BALANCE=100000
# SOLO DEV: salta il controllo on-chain per testare tutto il flusso prima del lancio.
DEV_BYPASS_TOKEN_GATE=true

# ----- WireGuard -----
# "mock" = nessun server reale (dev) | "local" = esegue `wg` su questo host
WIREGUARD_PROVIDER=mock
# Endpoint pubblico a cui si connettono i client
WG_SERVER_ENDPOINT=vpn.example.com:51820
# Chiave pubblica del server (da `wg show wg0 public-key`)
WG_SERVER_PUBLIC_KEY=
# Nome interfaccia sul server (provider "local")
WG_INTERFACE=wg0
# Subnet da cui assegnare gli IP ai client
WG_CLIENT_SUBNET=10.8.0.0/24
# DNS spinto ai client
WG_DNS=1.1.1.1
# Ogni quanto ricontrollare i saldi e revocare chi ha venduto (cron). Default: ogni ora.
REVERIFY_CRON=0 * * * *
