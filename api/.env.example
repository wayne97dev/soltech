# ----- Server -----
PORT=4000
NODE_ENV=development
# Allowed web origins (CORS), comma-separated
CORS_ORIGIN=http://localhost:3000

# ----- Auth -----
# In production: use a long, random string!
JWT_SECRET=dev-insecure-secret-change-me
# How long a login session lasts
JWT_TTL=7d

# ----- Database -----
# Dev: SQLite (zero setup). Prod: switch the provider in schema.prisma and use Postgres.
DATABASE_URL="file:./dev.db"

# ----- Robinhood Chain / token gating -----
# EVM RPC endpoint for Robinhood Chain (Arbitrum-stack L2). Mainnet default.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Chain id (mainnet 4663, testnet 46630).
CHAIN_ID=4663
# ERC-20 token contract address (from the NOXA launch). Empty = not launched yet.
TOKEN_ADDRESS=
# How many tokens (whole, not raw) are required for free VPN.
MIN_TOKEN_BALANCE=100000
# DEV ONLY: skip the on-chain check to test the whole flow before launch.
DEV_BYPASS_TOKEN_GATE=true

# ----- WireGuard -----
# "mock" = no real server (dev) | "local" = runs `wg` on this host
WIREGUARD_PROVIDER=mock
# Public endpoint clients connect to
WG_SERVER_ENDPOINT=vpn.example.com:51820
# Server public key (from `wg show wg0 public-key`)
WG_SERVER_PUBLIC_KEY=
# Interface name on the server (provider "local")
WG_INTERFACE=wg0
# Subnet to hand out client IPs from
WG_CLIENT_SUBNET=10.8.0.0/24
# DNS pushed to clients
WG_DNS=1.1.1.1
# How often to re-check balances and revoke sellers (cron). Default: hourly.
REVERIFY_CRON=0 * * * *

# ----- Multi-region VPN (optional) -----
# Leave REGIONS_JSON unset to run a SINGLE region synthesized from the WG_* vars
# above (backward compatible — the home node). To offer multiple exit countries,
# set REGIONS_JSON to a JSON array. The FIRST entry is the local node
# (control.kind "local"); each extra node runs infra/deploy/node.sh, which prints
# its object (control.kind "agent"). Each region needs its OWN clientSubnet.
# Example (single line in the real .env):
# REGIONS_JSON=[{"id":"de","name":"Germany","flag":"🇩🇪","city":"Frankfurt","endpoint":"144.91.104.144:51820","serverPublicKey":"<de_pubkey>","clientSubnet":"10.8.0.0/24","dns":"1.1.1.1","control":{"kind":"local","iface":"wg0"}},{"id":"us","name":"United States","flag":"🇺🇸","city":"New York","endpoint":"<us_ip>:51820","serverPublicKey":"<us_pubkey>","clientSubnet":"10.9.0.0/24","dns":"1.1.1.1","control":{"kind":"agent","url":"http://<us_ip>:8787","secret":"<shared_secret>"}}]
REGIONS_JSON=

# ----- Search (SearXNG) -----
# URL of a self-hosted SearXNG instance. Empty = demo/mock results (dev).
SEARXNG_URL=

# ----- Browser downloads (token-gated) -----
# Installer URLs (e.g. GitHub Releases). Empty = "coming soon" on the download page.
DOWNLOAD_MAC=
DOWNLOAD_WIN=
DOWNLOAD_LINUX=
